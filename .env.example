# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# Pooled connection string (used by the app at runtime). If you're using
# Neon via the Vercel Marketplace integration, this is auto-populated as
# DATABASE_URL when you attach the integration to your project.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled) connection string. Required for `prisma db push` /
# `prisma migrate` to run DDL statements, which don't work reliably through
# a PgBouncer/transaction-mode pooler. Neon's Vercel integration provides
# this automatically as DIRECT_URL / POSTGRES_URL_NON_POOLING.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── File storage (Vercel Blob) ────────────────────────────────────────────
# Auto-injected by Vercel when a Blob store is connected to the project.
# For local development, run `vercel env pull .env` after connecting the
# store, or create a token at https://vercel.com/dashboard -> Storage -> Blob.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"

# ── AI invoice extraction (OpenAI) ────────────────────────────────────────
# Optional at the environment level — users can also paste a personal key
# in Settings inside the app, which is stored per-deployment in the database
# and takes priority over this value. Without either, invoice upload still
# works but skips AI auto-extraction (manual entry only).
OPENAI_API_KEY="sk-...."

# Optional: override the OpenAI model used for invoice extraction.
# OPENAI_INVOICE_MODEL="gpt-4o-mini"
